# Spec Kit: the CLI reinstalls its own files; only produced artifacts are committed.
.claude/skills/speckit-**
.specify/*
!.specify/archive/
!.specify/memory/
.specify/memory/.constitution-template.json

# Spec Kit quality-gate checklists: useful only while a feature is being
# specified/planned, redundant once implemented — never commit these.
specs/*/checklists/requirements.md
.specify/archive/*/checklists/requirements.md
